# ─────────────────────────────────────────────────────────────
# Let's Draw — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it is already in .gitignore.
#
# WHERE TO PUT SECRETS:
#   Local dev  -> .env.local  (never committed, git-ignored)
#   Production -> Vercel Dashboard -> Project Settings -> Environment Variables
#
# Variables with NEXT_PUBLIC_ prefix are exposed to the browser.
# All others are server-only (safe for API keys).
# ─────────────────────────────────────────────────────────────

# SERVER-ONLY (never expose to browser)

# Google Gemini API key (default AI provider)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Sarvam AI API key (optional, Indian language support)
# Get one at: https://dashboard.sarvam.ai
SARVAM_API_KEY=

# PUBLIC (safe to expose to browser)

# Your deployed app URL (used for Open Graph and sitemap)
NEXT_PUBLIC_BASE_URL=https://lets-draw.vercel.app
